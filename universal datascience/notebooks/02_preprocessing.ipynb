   "source": [
    "# Step 4 — Data Cleaning and Preprocessing Pipeline\n",
    "**Project**: Deep Learning-Based Flood Prediction Using Rainfall Data  \n",
    "**Description**: Demonstrates loading raw dataset, handling missing & duplicate records, column selection, target encoding, chronological/stratified train-test splitting, feature scaling (preventing data leakage), and exporting cleaned artifacts to `data/processed/`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Add root project path to sys.path\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "\n",
    "from src.preprocessing import (\n",
    "    find_raw_dataset, \n",
    "    load_dataset, \n",
    "    clean_data, \n",
    "    identify_columns, \n",
    "    encode_target, \n",
    "    split_data_chronologically_or_stratified, \n",
    "    scale_features, \n",
    "    save_processed_data\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Raw Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    raw_path = find_raw_dataset('../data/raw')\n",
    "    df_raw = load_dataset(raw_path)\n",
    "    print(f\"Raw dataset shape: {df_raw.shape}\")
    "    df_raw.head()\n",
    "except FileNotFoundError as e:\n",
    "    print(f\"[NOTE] {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Data Cleaning (Missing Values & Duplicates)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df_raw' in locals():\n",
    "    df_cleaned = clean_data(df_raw)\n",
    "    print(f\"Missing values count per column:\\n{df_cleaned.isnull().sum()}\")\n",
    "    print(f\"Cleaned dataset shape: {df_cleaned.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Column & Target Identification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df_cleaned' in locals():\n",
    "    num_cols, cat_cols, target_col, time_col = identify_columns(df_cleaned)\n",
    "    print(f\"Numerical Features: {num_cols}\")\n",
    "    print(f\"Categorical Features: {cat_cols}\")\n",
    "    print(f\"Target Column: {target_col}\")\n",
    "    print(f\"Time Column: {time_col}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Train / Test Split (Chronological / Stratified)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'df_cleaned' in locals():\n",
    "    feature_cols = num_cols + cat_cols\n",
    "    X_train, X_test, y_train, y_test = split_data_chronologically_or_stratified(\n",
    "        df_cleaned, feature_cols, target_col, time_col=time_col, test_size=0.2, random_state=42\n",
    "    )\n",
    "    print(f\"X_train shape: {X_train.shape}, y_train shape: {y_train.shape}\")\n",
    "    print(f\"X_test shape: {X_test.shape}, y_test shape: {y_test.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Feature Scaling (Fit on Train Only)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'X_train' in locals():\n",
    "    X_train_scaled, X_test_scaled, scaler = scale_features(X_train, X_test, num_cols)\n",
    "    print(\"Feature scaling completed without data leakage.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Save Processed Artifacts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'X_train_scaled' in locals():\n",
    "    save_processed_data(X_train_scaled, X_test_scaled, y_train, y_test, '../data/processed')\n",
    "    print(\"Saved preprocessed data splits to ../data/processed/\")"
   ]
  }
